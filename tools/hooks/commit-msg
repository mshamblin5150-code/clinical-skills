#!/bin/sh
# Standing rule 4 spelling is advisory; ADR 0436 closing hazards refuse.
# Git supplies the message file as $1.

repo_root=$(git rev-parse --show-toplevel) || exit 0

for python in python python3 py; do
    if command -v "$python" >/dev/null 2>&1; then
        "$python" "$repo_root/tools/spelling_scan.py" \
            --commit-message "$1" --quiet >&2 || true

        # ADR 0436: every nonzero closing scan exit refuses the commit.
        "$python" "$repo_root/tools/closing_keyword_scan.py" \
            "$1" --quiet >&2 || exit $?
        exit 0
    fi
done

echo "spelling-scan: no python on PATH -- commit message check SKIPPED." >&2
echo "               Standing rule 4 is advisory; check American English by hand." >&2
echo "closing-keyword-scan: no python on PATH -- commit message check SKIPPED." >&2
echo "                      Check GitHub closing keywords by hand." >&2
exit 0
