#!/bin/sh
# Repair the gitignored skills mirror after Git materializes a new worktree.
# A branch checkout also passes $3=1, so the all-zero previous object id is the
# discriminator. Ordinary checkouts stay silent and do no work.
NULL_OID=0000000000000000000000000000000000000000
[ "$1" = "$NULL_OID" ] || exit 0

# core.hooksPath is the relative tools/hooks, so Git runs this file from the new
# worktree it has just made current (#1880). The tool is still resolved through
# that tree, which also covers a clone whose hooksPath names another checkout.
repo_root=$(git rev-parse --show-toplevel) || exit 0
[ -f "$repo_root/tools/skills_mirror.py" ] || exit 0

for python in python python3 py; do
    if command -v "$python" >/dev/null 2>&1; then
        # Mirror repair is advisory: failure must not turn a successful checkout
        # into a failed one, but non-quiet findings remain visible on stderr.
        "$python" "$repo_root/tools/skills_mirror.py" --repair --quiet >&2 || true
        break
    fi
done

exit 0
