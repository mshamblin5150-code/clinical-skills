#!/bin/sh
# Standing rule 1, enforced. See tools/phi_scan.py and CLAUDE.md.
# Bypass with `git commit --no-verify` only when you have checked by hand.

repo_root=$(git rev-parse --show-toplevel) || exit 0

for python in python python3 py; do
    if command -v "$python" >/dev/null 2>&1; then
        # Advisory, and deliberately not part of the exit status: a stale
        # .claude/skills/ mirror is a wiring fault, not PHI. Prints nothing when
        # the mirror is linked. See tools/skills_mirror.py.
        #
        # This comment used to close with "standing rule 1 stays the only thing
        # that refuses a commit in this repo". That stopped being true at #83 and
        # is doubly untrue now -- CLAUDE.md names the same sentence as a claim
        # that survived a merge past being false, in two other files, and this
        # was the third copy. Recorded rather than quietly deleted.
        "$python" "$repo_root/tools/skills_mirror.py" --quiet >&2 || true

        # Advisory on the same terms, and for the same reason: a British
        # spelling is standing rule 4, not PHI. Prints nothing when the staged
        # staged Markdown, Python and filenames are clean. See tools/spelling_scan.py.
        "$python" "$repo_root/tools/spelling_scan.py" --quiet >&2 || true

        # Advisory because ADR 0016 rules that another worktree's uncommitted
        # draft may warn but must never refuse this commit. The allocation tool
        # names every other worktree claiming a staged number. No staged ADR
        # means this cross-worktree read costs nothing.
        if git diff --cached --name-only --diff-filter=ACM \
            | grep -q '^docs/adr/'; then
            "$python" "$repo_root/tools/adr_next.py" --check-staged >&2 || true
        fi

        status=0

        # **The second thing in this repo that can refuse a commit, and the first
        # since standing rule 1.** That is a deliberate change in posture, ruled on
        # in #83 decision 1 rather than drifted into. The reasoning: a fabricated
        # citation in a threshold sheet is a number a clinician may act on, and the
        # checks that catch one are deterministic and unambiguous. A warning in a
        # hook is read past.
        #
        # **Only when a sheet is actually staged.** Every other commit pays nothing,
        # which is what keeps this from being the check people learn to --no-verify
        # around. `--all` rather than the staged paths: a sheet's conflict rule is a
        # statement about the whole directory, and grading one file in isolation
        # would miss a disagreement introduced between two of them.
        if git diff --cached --name-only --diff-filter=ACM \
            | grep '^reference/thresholds/[^/]*\.md$' \
            | grep -Ev '^reference/thresholds/(README|coverage)\.md$' \
            | grep -q .; then
            "$python" "$repo_root/tools/threshold_sheet.py" --all --quiet >&2 || status=1
        fi

        # **The third refusing check.** The topic registry is the directory's denominator, not a clinical sheet,
        # and has its own auditor. A catalog edit can change its population; a sheet
        # edit can orphan either side of a `sheet` row. README prose changes neither.
        if git diff --cached --name-only --diff-filter=ACM \
            | grep -E '^(reference/guidelines-catalog\.md|reference/thresholds/[^/]*\.md)$' \
            | grep -qv '^reference/thresholds/README\.md$'; then
            "$python" "$repo_root/tools/threshold_coverage.py" >&2 || status=1
        fi

        # Standing rule 1, and it is no longer `exec`ed. It still refuses on its own
        # and nothing above can suppress it -- the status is OR-ed, never replaced.
        #
        # Since #93 a non-zero here means one of two things: 1, PHI was found, or
        # 2, the corpus layer could not run and so no patient name was checked.
        # Both refuse, and this line needs no edit to tell them apart -- the
        # scanner prints which, in the words that say so.
        "$python" "$repo_root/tools/phi_scan.py" || status=1
        exit "$status"
    fi
done

echo "phi-scan: no python on PATH -- PHI check SKIPPED for this commit." >&2
echo "          Standing rule 1 is unenforced here; check by hand." >&2
exit 0
