# ---------------------------------------------------------------
# PHI FIREWALL — real patient data never enters this repo.
# Work on live notes inside scratch/. It is never committed.
# ---------------------------------------------------------------
scratch/
output/
cases/
patients/
*.phi
*.phi.md

# Exported spreadsheets / documents commonly carrying PHI
*.csv
*.xlsx
*.xls
*.docx
*.pdf

# Public CDC reference data committed for the pediatric BMI calculator (#123).
!reference/cdc-bmi-for-age-2022.csv

# Local Claude state is default-denied. The retrieval log is written by
# machinery outside this repository's control, so this is a publication
# boundary rather than a claim about what that file contains. Project hook
# settings are the one committed exception. Until that file exists, the
# tracked-file walk is vacuous and the direct ignore-source test holds it.
.claude/*
!.claude/settings.json
.codex/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Python bytecode from tools/
__pycache__/
*.pyc

# ---------------------------------------------------------------
# Guideline build artifacts. These hold society-copyrighted page
# text and recommendation text in full, and the repo is public.
# The write guards refuse a target inside a checkout -- this is the
# second net for the one that compares against known roots and so
# misses a sibling worktree (#176, #223). Not a substitute for them.
# ---------------------------------------------------------------
*-text/
guidelines-index/
recs-*.json
*.building
